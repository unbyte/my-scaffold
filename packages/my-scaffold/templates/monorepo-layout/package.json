{
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "biome check",
    "check:types": "tsc --build",
    "fix": "biome check --write",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "lefthook": "^2.2.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "error"
    }
  }
}
