{
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "biome check",
    "check:types": "tsc --noEmit",
    "fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "lefthook": "^2.1.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "error"
    }
  }
}
