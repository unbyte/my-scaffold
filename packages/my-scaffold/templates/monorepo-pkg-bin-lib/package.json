{
  "name": "{{ pkgName }}",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "lib"
  ],
  "bin": {
    "{{ binName }}": "./src/bin.ts"
  },
  "author": {
    "name": "unbyte",
    "url": "https://github.com/unbyte"
  },
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "turbo run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.{{#if cjs}}cjs{{else}}mjs{{/if}}",
{{#if esm}}
    "module": "lib/index.mjs",
{{/if}}
    "types": "lib/index.d.{{#if esm}}mts{{else}}cts{{/if}}",
    "exports": {
      ".": {
{{#if esm}}
        "import": {
          "types": "./lib/index.d.mts",
          "default": "./lib/index.mjs"
        }{{#if cjs}},{{/if}}
{{/if}}
{{#if cjs}}
        "{{#if esm}}require{{else}}default{{/if}}": {
          "types": "./lib/index.d.cts",
          "default": "./lib/index.cjs"
        }
{{/if}}
      }
    },
    "bin": {
      "{{ binName }}": "./lib/bin.{{#if esm}}mjs{{else}}cjs{{/if}}"
    }
  }
}
