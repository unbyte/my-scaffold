{
  "name": "{{ pkgName }}",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "lib"
  ],
  "author": {
    "name": "unbyte",
    "url": "https://github.com/unbyte"
  },
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "turbo run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.{{#if cjs}}cjs{{else}}{{ esmExtension }}{{/if}}",
{{#if esm}}
    "module": "lib/index.{{ esmExtension }}",
{{/if}}
    "types": "lib/index.d.{{#if esm}}{{ esmDeclarationExtension }}{{else}}cts{{/if}}",
    "exports": {
      ".": {
{{#if esm}}
        "import": {
          "types": "./lib/index.d.{{ esmDeclarationExtension }}",
          "default": "./lib/index.{{ esmExtension }}"
        }{{#if cjs}},{{/if}}
{{/if}}
{{#if cjs}}
        "{{#if esm}}require{{else}}default{{/if}}": {
          "types": "./lib/index.d.cts",
          "default": "./lib/index.cjs"
        }
{{/if}}
      }
    }
  }
}
