{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"{{#if browser}}, "dom", "dom.iterable"{{/if}}],
    "types": [{{#if node}}"node"{{/if}}],
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tsbuildinfo"
  },
  "include": ["src", "tests"]
}
